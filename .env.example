# Copy this tracked template to .env, then fill in private values locally.
# Never commit .env. Generate JWT_SECRET with: openssl rand -hex 32
# POSTGRES_PASSWORD and DB_PASSWORD must match.
# Set the 42 OAuth callback URL in the 42 application to match your local URL.
# tools/prepare_local.py validates .env and creates the local TLS certificate.
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
PUBLIC_BASE_URL=
JWT_SECRET=
ALLOW_LEGACY_HEADER=0
SESSION_TTL_HOURS=168
POSTGRES_USER=binder_user
POSTGRES_PASSWORD=
POSTGRES_DB=card_binder_db
DB_PASSWORD=
GIPHY_API_KEY=
