<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Binder Pro - Sala de Espera (Lobby)</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b0705; color: #fef3c7; }
        .magic-title { font-family: 'Cinzel', serif; }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4">

    <!-- Cabecera del Lobby -->
    <div class="w-full max-w-4xl flex flex-wrap gap-3 justify-between items-center mb-6 bg-[#140e09] border border-[#b39258]/30 p-4 rounded-xl shadow-lg">
        <div>
            <h1 class="magic-title text-xl text-amber-400 font-bold">🏛️ Sala de Duelo: <span id="room-name-display">sala-1</span></h1>
            <p id="room-status" class="text-xs text-amber-200/60">Conectando al vestíbulo...</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="text-right">
                <span class="text-xs text-amber-200/70">Jugadores en sala:</span>
                <span id="player-count" class="text-xl font-bold text-emerald-400 ml-2">0/4</span>
            </div>
            <button id="invite-btn" type="button" class="bg-[#1e140d] hover:bg-[#2a1d13] text-amber-200 font-semibold px-3 py-2 rounded-xl text-xs transition-all border border-[#b39258]/40 cursor-pointer">
                🔗 Invitar
            </button>
            <button id="leave-room-btn" type="button" class="bg-red-900/80 hover:bg-red-800 text-white font-bold px-3 py-2 rounded-xl text-xs transition-all shadow cursor-pointer border border-red-700/50">
                🚪 Salir
            </button>
        </div>
    </div>

    <!-- Contenedor Principal -->
    <div class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Jugadores y controles del Host -->
        <div class="bg-[#140e09] border border-[#b39258]/40 rounded-2xl p-6 shadow-2xl flex flex-col justify-between">
            <div>
                <h2 class="magic-title text-sm font-bold text-amber-400 mb-4 uppercase tracking-wider">👥 Combatientes</h2>
                <ul id="players-list" class="space-y-2 mb-6">
                    <li class="text-xs text-amber-200/50 italic">Esperando jugadores...</li>
                </ul>
            </div>

            <div id="host-controls" class="hidden border-t border-[#b39258]/20 pt-4 mt-4">
                <h3 class="text-xs font-semibold text-amber-300 mb-2">⚙️ Configuración de Sala</h3>
                <label for="max-players-select" class="block text-[11px] text-amber-200/70 mb-1">Máximo de jugadores:</label>
                <select id="max-players-select" class="w-full bg-[#0b0705] border border-[#b39258]/30 text-amber-100 text-xs rounded-lg p-2 mb-4 focus:outline-none focus:border-amber-400">
                    <option value="1">1 Jugador (Práctica)</option>
                    <option value="2">2 Jugadores (Duelo)</option>
                    <option value="3">3 Jugadores</option>
                    <option value="4" selected>4 Jugadores</option>
                </select>

                <button id="start-game-btn" type="button" class="w-full bg-emerald-700 hover:bg-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold py-3 px-4 rounded-xl text-sm transition-all shadow-lg cursor-pointer">
                    🚀 Comenzar Partida
                </button>
            </div>
            <div id="waiting-host-msg" class="text-center text-xs text-amber-200/60 italic border-t border-[#b39258]/20 pt-4 mt-4">
                Esperando a que el Host inicie la partida...
            </div>
        </div>

        <!-- Chat -->
        <div class="md:col-span-2 bg-[#140e09] border border-[#b39258]/40 rounded-2xl p-6 shadow-2xl flex flex-col justify-between h-[400px] md:h-auto">
            <h2 class="magic-title text-sm font-bold text-amber-400 mb-4 uppercase tracking-wider">💬 Conversación en el Vestíbulo</h2>

            <div id="chat-messages" aria-live="polite" class="flex-1 bg-[#0b0705] border border-[#b39258]/20 rounded-xl p-4 overflow-y-auto space-y-2 mb-4 text-xs">
                <div class="text-amber-200/40 italic">Bienvenido al vestíbulo. ¡Prepara tus tácticas!</div>
            </div>

            <form id="chat-form" class="flex gap-2">
                <input type="text" id="chat-input" placeholder="Escribe un mensaje..." autocomplete="off" maxlength="200"
                    class="flex-1 bg-[#0b0705] border border-[#b39258]/30 text-amber-100 text-xs rounded-xl px-4 py-3 focus:outline-none focus:border-amber-400">
                <button type="submit" class="bg-amber-600 hover:bg-amber-500 text-black font-bold px-5 py-3 rounded-xl text-xs transition-all cursor-pointer">
                    Enviar
                </button>
            </form>
        </div>

    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const API_HOST = location.host;

            const roomStatus = document.getElementById("room-status");
            const playerCount = document.getElementById("player-count");
            const playersList = document.getElementById("players-list");
            const hostControls = document.getElementById("host-controls");
            const waitingHostMsg = document.getElementById("waiting-host-msg");
            const maxPlayersSelect = document.getElementById("max-players-select");
            const startGameBtn = document.getElementById("start-game-btn");
            const chatMessages = document.getElementById("chat-messages");
            const chatForm = document.getElementById("chat-form");
            const chatInput = document.getElementById("chat-input");
            const leaveRoomBtn = document.getElementById("leave-room-btn");
            const inviteBtn = document.getElementById("invite-btn");

            // ---- Sesión: si no hay usuario guardado, se genera UNA vez y se persiste,
            // para que game.html use exactamente el mismo nombre ----
            let userSession = JSON.parse(localStorage.getItem("user_session")) ||
                              JSON.parse(localStorage.getItem("cardbinder_user"));
            if (!userSession || !userSession.username) {
                userSession = { username: "Conjurador_" + Math.floor(Math.random() * 1000) };
            }
            const urlParams = new URLSearchParams(window.location.search);
            // ?user=Ana permite probar varios jugadores en el mismo navegador (se recuerda por pestaña)
            if (urlParams.get("user")) sessionStorage.setItem("cb_tab_user", urlParams.get("user"));
            const tabUser = sessionStorage.getItem("cb_tab_user");
            if (!tabUser) localStorage.setItem("user_session", JSON.stringify({ username: userSession.username }));
            const username = tabUser || userSession.username;

            const roomId = urlParams.get("room") || "sala-1";
            document.getElementById("room-name-display").textContent = roomId;

            let ws = null;
            let isHost = false;
            let leaving = false;          // salida voluntaria o paso a la partida: no reconectar
            let reconnectTimer = null;
            let knownPlayers = null;      // para anunciar entradas/salidas en el chat

            // ---------------- WebSocket con reconexión ----------------
            function connectLobbyWebSocket() {
                ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${API_HOST}/api/game/ws/lobby/${encodeURIComponent(roomId)}?username=${encodeURIComponent(username)}`);

                ws.onopen = () => {
                    roomStatus.textContent = "🟢 Conectado al vestíbulo";
                };

                ws.onmessage = (event) => {
                    const data = JSON.parse(event.data);

                    if (data.type === "LOBBY_STATE") {
                        updateLobbyUI(data.players, data.max_players);
                    } else if (data.type === "CHAT_MESSAGE") {
                        appendChatMessage(data.username, data.message);
                    } else if (data.type === "START_GAME") {
                        leaving = true;
                        window.location.href = `game.html?room=${encodeURIComponent(roomId)}`;
                    }
                };

                ws.onclose = () => {
                    if (leaving) return;
                    roomStatus.textContent = "🔴 Desconectado. Reconectando...";
                    clearTimeout(reconnectTimer);
                    reconnectTimer = setTimeout(connectLobbyWebSocket, 2000);
                };
            }

            function send(payload) {
                if (ws && ws.readyState === WebSocket.OPEN) {
                    ws.send(JSON.stringify(payload));
                    return true;
                }
                return false;
            }

            // ---------------- UI ----------------
            function updateLobbyUI(players, maxPlayers) {
                playerCount.textContent = `${players.length}/${maxPlayers}`;
                playersList.innerHTML = "";
                isHost = false;

                if (players.length === 0) {
                    const li = document.createElement("li");
                    li.className = "text-xs text-amber-200/50 italic";
                    li.textContent = "Esperando jugadores...";
                    playersList.appendChild(li);
                }

                players.forEach(p => {
                    const isMe = p.username === username;

                    const li = document.createElement("li");
                    li.className = "flex justify-between items-center bg-[#0b0705] border p-2.5 rounded-lg text-xs " +
                        (isMe ? "border-amber-400/50" : "border-[#b39258]/20");

                    const nameSpan = document.createElement("span");
                    nameSpan.className = "font-medium text-amber-100 flex items-center gap-1.5";
                    nameSpan.textContent = p.username + (isMe ? " (tú)" : "");

                    if (p.is_host) {
                        const hostBadge = document.createElement("span");
                        hostBadge.className = "bg-amber-500/20 text-amber-400 text-[10px] px-1.5 py-0.5 rounded font-bold border border-amber-500/30";
                        hostBadge.textContent = "HOST";
                        nameSpan.appendChild(hostBadge);
                    }

                    li.appendChild(nameSpan);
                    playersList.appendChild(li);

                    if (isMe && p.is_host) isHost = true;
                });

                // Avisos de entrada/salida (no en la primera carga)
                const names = new Set(players.map(p => p.username));
                if (knownPlayers) {
                    names.forEach(n => { if (!knownPlayers.has(n) && n !== username) appendSystemMessage(`${n} se ha unido a la sala.`); });
                    knownPlayers.forEach(n => { if (!names.has(n)) appendSystemMessage(`${n} ha abandonado la sala.`); });
                }
                knownPlayers = names;

                // Controles del Host
                if (isHost) {
                    hostControls.classList.remove("hidden");
                    waitingHostMsg.classList.add("hidden");
                    maxPlayersSelect.value = maxPlayers;
                    // No permitir un máximo menor que los jugadores ya presentes
                    Array.from(maxPlayersSelect.options).forEach(opt => {
                        opt.disabled = parseInt(opt.value) < players.length;
                    });
                } else {
                    hostControls.classList.add("hidden");
                    waitingHostMsg.classList.remove("hidden");
                }
            }

            function appendChatMessage(author, message) {
                const isMe = author === username;
                const div = document.createElement("div");

                const strong = document.createElement("strong");
                strong.className = isMe ? "text-emerald-400" : "text-amber-400";
                strong.textContent = `${author}: `;

                const span = document.createElement("span");
                span.className = "text-amber-100/90 break-words";
                span.textContent = message;   // textContent: sin inyección de HTML

                div.appendChild(strong);
                div.appendChild(span);
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            function appendSystemMessage(text) {
                const div = document.createElement("div");
                div.className = "text-amber-200/40 italic";
                div.textContent = `— ${text}`;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            // ---------------- Eventos ----------------
            chatForm.addEventListener("submit", (e) => {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (!text) return;
                if (send({ action: "CHAT_MESSAGE", username, message: text })) {
                    chatInput.value = "";
                }
            });

            maxPlayersSelect.addEventListener("change", () => {
                if (isHost) send({ action: "UPDATE_CONFIG", max_players: parseInt(maxPlayersSelect.value) });
            });

            startGameBtn.addEventListener("click", () => {
                if (!isHost) return;
                if (send({ action: "START_GAME" })) {
                    startGameBtn.disabled = true;
                    startGameBtn.textContent = "Iniciando...";
                    // Si por algún motivo no llega la orden de arranque, se reactiva
                    setTimeout(() => {
                        startGameBtn.disabled = false;
                        startGameBtn.textContent = "🚀 Comenzar Partida";
                    }, 4000);
                }
            });

            leaveRoomBtn.addEventListener("click", () => {
                leaving = true;
                clearTimeout(reconnectTimer);
                if (ws) ws.close();   // el backend reasigna host o desmonta la sala si queda vacía
                window.location.href = "rooms.html";
            });

            // Enlace de invitación a esta sala
            inviteBtn.addEventListener("click", async () => {
                const link = `${location.origin}${location.pathname}?room=${encodeURIComponent(roomId)}`;
                let ok = false;
                try {
                    await navigator.clipboard.writeText(link);
                    ok = true;
                } catch (_) {
                    ok = false;
                }
                const original = "🔗 Invitar";
                inviteBtn.textContent = ok ? "✅ ¡Enlace copiado!" : "⚠️ No se pudo copiar";
                setTimeout(() => { inviteBtn.textContent = original; }, 1800);
            });

            connectLobbyWebSocket();
        });
    </script>
</body>
</html>